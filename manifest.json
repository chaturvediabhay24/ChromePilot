{
  "manifest_version": 3,
  "name": "ChromePilot - Browser Agent",
  "version": "0.1.5",
  "description": "Automate browser tasks from a side panel with GitHub Copilot. Compatible Copilot access required.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "ChromePilot - Browser Agent"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "author": "Abhay Chaturvedi",
  "homepage_url": "https://github.com/chaturvediabhay24/ChromePilot"
}
